---
// Unstyled calendar button for the redesign mockups. Uses the same data
// attributes as CalendarButton.astro so scripts/calendar-button.js picks it up.
// Sample (projected) events render a non-functional placeholder instead.
import type { HomeEvent } from "@utils/homeData";

interface Props {
  event: HomeEvent;
  isSample?: boolean;
  class?: string;
}

const { event, isSample = false, class: className } = Astro.props;
const label = `Termin „${event.title}“ zum Kalender hinzufügen`;
---

{
  isSample ? (
    <span class:list={[className]} aria-disabled="true" title="Beispieltermin – nicht herunterladbar">
      <slot />
    </span>
  ) : (
    <button
      type="button"
      class:list={["calendar-button", className]}
      data-title={event.title}
      data-date={event.date.toISOString()}
      data-description={event.description}
      data-start-time={event.startTime}
      data-end-time={event.endTime}
      aria-label={label}>
      <slot />
    </button>
  )
}
