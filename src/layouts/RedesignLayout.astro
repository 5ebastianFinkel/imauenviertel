---
// Standalone layout for the start page redesign mockups: no global navbar,
// footer or fonts, so every mockup brings its own complete look.
interface Props {
  title: string;
  themeColor: string;
  current?: 1 | 2 | 3 | 4;
}

const { title, themeColor, current } = Astro.props;

const mockups = [
  { id: 1, name: "Gartenjournal", path: "/redesign/1" },
  { id: 2, name: "Beetfest", path: "/redesign/2" },
  { id: 3, name: "Abendgarten", path: "/redesign/3" },
  { id: 4, name: "Morgengarten", path: "/redesign/4" },
];
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content={themeColor} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} · Redesign-Vorschau · Im Auenviertel</title>
  </head>
  <body>
    <slot />

    <nav class="mockup-switcher" aria-label="Redesign-Entwürfe">
      <a href="/redesign" class="mockup-switcher__label">Entwurf</a>
      {
        mockups.map((m) => (
          <a href={m.path} aria-current={m.id === current ? "page" : undefined}>
            <span>{m.id}</span>
            <span class="mockup-switcher__name">{m.name}</span>
          </a>
        ))
      }
    </nav>

    <style is:global>
      html { -webkit-text-size-adjust: 100%; }
      body { margin: 0; }
      *, *::before, *::after { box-sizing: border-box; }
      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after {
          animation-duration: 0.01ms !important;
          animation-delay: 0ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
          scroll-behavior: auto !important;
        }
      }
    </style>

    <style>
      .mockup-switcher {
        position: fixed;
        left: 50%;
        bottom: calc(1rem + env(safe-area-inset-bottom, 0px));
        transform: translateX(-50%);
        z-index: 100;
        display: flex;
        align-items: center;
        gap: 0.25rem;
        padding: 0.35rem;
        border-radius: 999px;
        background: rgb(20 20 20 / 0.82);
        backdrop-filter: blur(12px);
        box-shadow: 0 10px 30px rgb(0 0 0 / 0.25);
        font: 500 13px/1 ui-sans-serif, system-ui, sans-serif;
        white-space: nowrap;
      }
      .mockup-switcher a {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.55rem 0.8rem;
        border-radius: 999px;
        color: rgb(255 255 255 / 0.75);
        text-decoration: none;
      }
      .mockup-switcher a:hover { color: #fff; background: rgb(255 255 255 / 0.1); }
      .mockup-switcher a[aria-current="page"] { color: #111; background: #fff; }
      .mockup-switcher__label { color: rgb(255 255 255 / 0.5) !important; text-transform: uppercase; letter-spacing: 0.08em; font-size: 11px; }
      @media (max-width: 560px) {
        .mockup-switcher__name { display: none; }
      }
    </style>
  </body>
</html>
