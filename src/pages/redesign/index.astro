---
// Overview of the start page redesign mockups
import RedesignLayout from "@layouts/RedesignLayout.astro";

const mockups = [
  {
    id: 1,
    name: "Gartenjournal",
    style: "Natürlich & warm",
    text: "Leinenpapier, Erdtöne und Serifen wie in einem Gartenmagazin. Termine als Almanach, Dokumente als Register.",
    swatches: ["#f2ebdd", "#2f241b", "#4c6a3a", "#b85c38"],
  },
  {
    id: 2,
    name: "Beetfest",
    style: "Lebendig & verspielt",
    text: "Bento-Kacheln in den Logofarben, dicke Konturen und Abreißkalender-Termine. Laut, fröhlich, gemeinschaftlich.",
    swatches: ["#fff6e3", "#f7c21b", "#d1531f", "#2f8a3c", "#1f6fbf"],
  },
  {
    id: 3,
    name: "Abendgarten",
    style: "Warm & modern, dunkel",
    text: "Vollflächiges Foto, elegante Kursiv-Serife und eine Termin-Zeitleiste. Mischung aus natürlicher Wärme und ruhiger Eleganz.",
    swatches: ["#0f1d16", "#16281f", "#f1ead8", "#f2c14e"],
  },
  {
    id: 4,
    name: "Morgengarten",
    style: "Variante von 3, hell",
    text: "Gleicher Aufbau wie der Abendgarten, aber hell und freundlich: warmes Weiß, tiefes Gartengrün, Terrakotta und Sonnenblumengelb.",
    swatches: ["#fbf7ee", "#1f3a2b", "#b9502a", "#f4c247", "#4f8a3c"],
  },
];
---

<RedesignLayout title="Übersicht" themeColor="#faf8f3">
  <main class="overview">
    <p class="eyebrow">Im Auenviertel · Redesign der Startseite</p>
    <h1>Vier Entwürfe</h1>
    <p class="intro">
      Alle Entwürfe nutzen die echten Inhalte: die nächsten Termine sowie Dokumente &amp; Links aus
      dem CMS. Unten in der Leiste kannst du jederzeit zwischen den Entwürfen wechseln.
    </p>
    <ul>
      {
        mockups.map((m) => (
          <li>
            <a href={`/redesign/${m.id}`}>
              <span class="num">{m.id}</span>
              <span class="body">
                <span class="name">{m.name}</span>
                <span class="style">{m.style}</span>
                <span class="text">{m.text}</span>
              </span>
              <span class="swatches" aria-hidden="true">
                {m.swatches.map((c) => <span style={`background:${c}`} />)}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </main>
</RedesignLayout>

<style>
  .overview {
    min-height: 100vh;
    padding: 4rem max(1.25rem, calc((100% - 820px) / 2)) 8rem;
    background: #faf8f3;
    color: #1d1d1b;
    font-family: ui-sans-serif, system-ui, sans-serif;
    line-height: 1.55;
  }
  .eyebrow { margin: 0; font-size: 0.8rem; letter-spacing: 0.14em; text-transform: uppercase; color: #777; }
  h1 { margin: 0.5rem 0 0; font-size: clamp(2.2rem, 6vw, 3.4rem); line-height: 1.05; }
  .intro { max-width: 38rem; margin: 1rem 0 2.5rem; color: #555; }
  ul { display: grid; gap: 1rem; margin: 0; padding: 0; list-style: none; }
  a { display: grid; grid-template-columns: auto 1fr auto; gap: 1.25rem; align-items: center; padding: 1.4rem; border: 1px solid #e3ded3; border-radius: 18px; background: #fff; color: inherit; text-decoration: none; transition: transform 0.2s, box-shadow 0.2s; }
  a:hover { transform: translateY(-2px); box-shadow: 0 14px 30px -18px rgb(0 0 0 / 0.35); }
  .num { display: grid; place-items: center; width: 2.6rem; height: 2.6rem; border-radius: 50%; background: #1d1d1b; color: #fff; font-weight: 700; }
  .body { display: flex; flex-direction: column; }
  .name { font-size: 1.3rem; font-weight: 700; }
  .style { font-size: 0.85rem; font-weight: 600; color: #8a6d3b; }
  .text { margin-top: 0.35rem; color: #555; font-size: 0.95rem; }
  .swatches { display: flex; }
  .swatches span { width: 26px; height: 26px; margin-left: -8px; border: 2px solid #fff; border-radius: 50%; box-shadow: 0 0 0 1px #e3ded3; }
  @media (max-width: 600px) {
    a { grid-template-columns: auto 1fr; }
    .swatches { grid-column: 2; }
  }
</style>
