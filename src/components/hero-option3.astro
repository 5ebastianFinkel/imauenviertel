---
import { Picture } from "astro:assets";
import heroImage from "@assets/Blumen.webp";
import Link from "@components/ui/link.astro";
---

<!-- Option 3: "Frühlingserwachen" — Fresh, vibrant, modern, optimistic -->
<section class="hero-spring relative w-full overflow-hidden">
  <!-- Fresh gradient: cool morning transitioning to warm light -->
  <div class="absolute inset-0 bg-gradient-to-br from-teal-50 via-cyan-50 to-rose-50"></div>

  <!-- Organic blob shapes -->
  <div class="blobs" aria-hidden="true">
    <div class="blob blob-1"></div>
    <div class="blob blob-2"></div>
    <div class="blob blob-3"></div>
  </div>

  <!-- Rising light particles -->
  <div class="particles" aria-hidden="true">
    <div class="particle p-1"></div>
    <div class="particle p-2"></div>
    <div class="particle p-3"></div>
    <div class="particle p-4"></div>
    <div class="particle p-5"></div>
    <div class="particle p-6"></div>
    <div class="particle p-7"></div>
    <div class="particle p-8"></div>
    <div class="particle p-9"></div>
    <div class="particle p-10"></div>
    <div class="particle p-11"></div>
    <div class="particle p-12"></div>
  </div>

  <!-- Diagonal accent strip -->
  <div class="absolute -top-20 -right-20 w-[500px] h-[500px] bg-gradient-to-bl from-teal-200/20 to-transparent rotate-12 rounded-3xl" aria-hidden="true"></div>
  <div class="absolute -bottom-20 -left-20 w-[400px] h-[400px] bg-gradient-to-tr from-rose-200/15 to-transparent -rotate-12 rounded-3xl" aria-hidden="true"></div>

  <!-- Bottom transition -->
  <div class="absolute bottom-0 left-0 right-0 h-32 bg-gradient-to-t from-[#FEFDF6] to-transparent z-10"></div>

  <!-- Main Content -->
  <div class="relative z-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24 lg:py-32">
    <div class="grid lg:grid-cols-2 gap-8 lg:gap-12 items-center">

      <!-- Text Content -->
      <div class="text-center lg:text-left order-2 lg:order-1">
        <!-- Season badge -->
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-gradient-to-r from-teal-500/10 to-cyan-500/10 backdrop-blur-sm text-teal-700 text-sm font-medium mb-6 border border-teal-300/30">
          <svg class="w-4 h-4 text-teal-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 3v1m0 16v1m-9-9h1m16 0h1m-2.636-6.364l-.707.707M6.343 17.657l-.707.707m0-12.728l.707.707m11.314 11.314l.707.707"/>
            <circle cx="12" cy="12" r="4"/>
          </svg>
          <span>Frühlingserwachen 2026</span>
        </div>

        <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl xl:text-7xl font-bold tracking-tight mb-6">
          <span class="block text-slate-800">Kleingartenverein</span>
          <span class="block bg-gradient-to-r from-teal-600 via-emerald-500 to-cyan-500 bg-clip-text text-transparent">im Auenviertel</span>
        </h1>

        <p class="text-lg sm:text-xl text-slate-600 max-w-xl mx-auto lg:mx-0 mb-8 leading-relaxed">
          Die Tage werden länger, die ersten Krokusse durchbrechen die Erde — ein neues Gartenjahr beginnt! Entdecken Sie, was in unserem Verein wächst und blüht.
        </p>

        <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start">
          <Link
            href="/blog"
            block
            style="primary"
            class="!bg-gradient-to-r !from-teal-500 !to-emerald-500 hover:!from-teal-400 hover:!to-emerald-400 !text-white !border-teal-500 !font-semibold shadow-lg shadow-teal-200 transition-all duration-300 hover:shadow-xl hover:shadow-teal-300 hover:-translate-y-0.5">
            Neuigkeiten
          </Link>
          <Link
            href="/dates"
            block
            style="outline"
            class="!bg-white/70 !border-teal-300 !text-teal-700 hover:!bg-teal-50 hover:!border-teal-400 shadow-sm transition-all duration-300 hover:-translate-y-0.5">
            Termine
          </Link>
        </div>

        <!-- Quick info cards -->
        <div class="flex flex-wrap gap-3 mt-8 justify-center lg:justify-start">
          <div class="flex items-center gap-2 px-3 py-1.5 rounded-lg bg-white/60 backdrop-blur-sm text-sm text-slate-600 border border-slate-200/50">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
            Gemeinschaft
          </div>
          <div class="flex items-center gap-2 px-3 py-1.5 rounded-lg bg-white/60 backdrop-blur-sm text-sm text-slate-600 border border-slate-200/50">
            <span class="w-1.5 h-1.5 rounded-full bg-teal-400"></span>
            Natur
          </div>
          <div class="flex items-center gap-2 px-3 py-1.5 rounded-lg bg-white/60 backdrop-blur-sm text-sm text-slate-600 border border-slate-200/50">
            <span class="w-1.5 h-1.5 rounded-full bg-cyan-400"></span>
            Erholung
          </div>
        </div>
      </div>

      <!-- Image -->
      <div class="order-1 lg:order-2 flex justify-center">
        <div class="relative">
          <!-- Colorful rings behind image -->
          <div class="absolute -inset-6 rounded-full bg-gradient-to-br from-teal-300/20 via-transparent to-rose-300/20 blur-xl animate-ring-pulse"></div>
          <div class="absolute -inset-3 rounded-2xl bg-gradient-to-tr from-teal-200/30 to-cyan-200/20 blur-md"></div>
          <Picture
            src={heroImage}
            alt="Frühlingsblumen im Kleingarten — Krokusse und erste Blüten"
            widths={[300, 450, 600]}
            sizes="(max-width: 640px) 300px, (max-width: 1024px) 450px, 600px"
            loading="eager"
            class="relative w-full max-w-md lg:max-w-lg rounded-2xl shadow-xl shadow-teal-200/40 border-2 border-white/50 animate-spring-bob"
          />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Spring bob animation */
  @keyframes spring-bob {
    0%, 100% { transform: translateY(0) scale(1); }
    50% { transform: translateY(-12px) scale(1.01); }
  }
  .animate-spring-bob {
    animation: spring-bob 5s ease-in-out infinite;
  }

  @keyframes ring-pulse {
    0%, 100% { transform: scale(1); opacity: 0.6; }
    50% { transform: scale(1.05); opacity: 0.8; }
  }
  .animate-ring-pulse {
    animation: ring-pulse 6s ease-in-out infinite;
  }

  /* Organic blob shapes */
  .blobs {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    overflow: hidden;
  }

  .blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(60px);
  }

  .blob-1 {
    width: 400px;
    height: 400px;
    top: -10%;
    left: -5%;
    background: rgba(45, 212, 191, 0.08);
    animation: blob-move 20s ease-in-out infinite;
  }

  .blob-2 {
    width: 300px;
    height: 300px;
    bottom: 10%;
    right: -5%;
    background: rgba(244, 114, 182, 0.06);
    animation: blob-move 18s ease-in-out infinite 5s;
  }

  .blob-3 {
    width: 250px;
    height: 250px;
    top: 40%;
    left: 40%;
    background: rgba(6, 182, 212, 0.06);
    animation: blob-move 22s ease-in-out infinite 10s;
  }

  @keyframes blob-move {
    0%, 100% { transform: translate(0, 0) scale(1); }
    25% { transform: translate(30px, -20px) scale(1.05); }
    50% { transform: translate(-20px, 20px) scale(0.95); }
    75% { transform: translate(10px, 10px) scale(1.02); }
  }

  /* Rising light particles */
  .particles {
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
    overflow: hidden;
  }

  .particle {
    position: absolute;
    bottom: -10px;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    opacity: 0;
  }

  .particle:nth-child(3n+1) { background: rgba(45, 212, 191, 0.5); }
  .particle:nth-child(3n+2) { background: rgba(16, 185, 129, 0.4); }
  .particle:nth-child(3n)   { background: rgba(244, 114, 182, 0.3); }

  .p-1  { left: 5%;  animation: particle-rise 8s linear infinite 0s; }
  .p-2  { left: 12%; animation: particle-rise 10s linear infinite 2s; width: 3px; height: 3px; }
  .p-3  { left: 22%; animation: particle-rise 9s linear infinite 4s; }
  .p-4  { left: 30%; animation: particle-rise 11s linear infinite 1s; width: 5px; height: 5px; }
  .p-5  { left: 42%; animation: particle-rise 8s linear infinite 6s; }
  .p-6  { left: 55%; animation: particle-rise 12s linear infinite 3s; width: 3px; height: 3px; }
  .p-7  { left: 65%; animation: particle-rise 9s linear infinite 5s; }
  .p-8  { left: 75%; animation: particle-rise 10s linear infinite 7s; width: 5px; height: 5px; }
  .p-9  { left: 85%; animation: particle-rise 8s linear infinite 2s; }
  .p-10 { left: 92%; animation: particle-rise 11s linear infinite 4s; width: 3px; height: 3px; }
  .p-11 { left: 48%; animation: particle-rise 13s linear infinite 8s; }
  .p-12 { left: 18%; animation: particle-rise 9s linear infinite 6s; width: 5px; height: 5px; }

  @keyframes particle-rise {
    0% {
      transform: translateY(0) translateX(0);
      opacity: 0;
    }
    10% { opacity: 0.6; }
    50% {
      transform: translateY(-50vh) translateX(15px);
      opacity: 0.3;
    }
    90% { opacity: 0; }
    100% {
      transform: translateY(-100vh) translateX(-10px);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .animate-spring-bob,
    .animate-ring-pulse,
    .blob,
    .particle {
      animation: none;
    }
    .particle { display: none; }
  }
</style>
