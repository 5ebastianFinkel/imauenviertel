---
interface Props {
  size?: "md" | "lg";
  block?: boolean;
  style?: "outline" | "primary" | "inverted";
  class?: string;
  [x: string]: any;
}

const {
  size = "md",
  style = "primary",
  block,
  class: className,
  ...rest
} = Astro.props;

// Mapped onto the shared .btn styles in globals.css
const sizes = {
  md: "",
  lg: "text-lg",
};

const styles = {
  primary: "btn",
  outline: "btn btn-outline",
  inverted: "btn bg-white",
  muted: "inline-flex px-2 py-1 hover:text-accent transition-colors",
};
---

<button
  {...rest}
  class:list={[
    block && "btn-block",
    sizes[size],
    styles[style],
    className,
  ]}
  ><slot />
</button>
