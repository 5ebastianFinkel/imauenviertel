---
// Mockup 2 — "Beetfest": lively & playful bento grid in the logo colours
import "@fontsource-variable/bricolage-grotesque";
import { Picture } from "astro:assets";
import RedesignLayout from "@layouts/RedesignLayout.astro";
import EventCalendarButton from "@components/redesign/EventCalendarButton.astro";
import veggiesImage from "@assets/hero-alternative.avif";
import flowerImage from "@assets/Blumen.webp";
import pathImage from "@assets/Ergebnis_Heckenschnitt.webp";
import logo from "@assets/logo.avif";
import {
  getHomeEvents,
  getHomeDocuments,
  getHomeLinks,
  formatTime,
  day,
  monthShort,
  weekday,
} from "@utils/homeData";

const { events, isSample } = await getHomeEvents(4);
const documents = await getHomeDocuments(6);
const links = await getHomeLinks(4);

const tones = ["rust", "leaf", "river", "sun"] as const;
const tilts = ["-2deg", "1.5deg", "-1deg", "2deg"];

const nav = [
  { title: "Neuigkeiten", path: "/blog" },
  { title: "Termine", path: "/dates" },
  { title: "Über uns", path: "/about" },
  { title: "Dokumente", path: "/documents" },
];

const marquee = ["Gemeinschaftsarbeit", "Sommerfest", "Heckenschnitt", "Abgrillen", "Mitgliederversammlung", "Erntezeit"];
---

<RedesignLayout title="Beetfest" themeColor="#fff6e3" current={2}>
  <div class="beet">
    <header class="top wrap">
      <a href="/redesign/2" class="brand" aria-label="Im Auenviertel – Startseite">
        <Picture src={logo} alt="" widths={[48, 96]} sizes="40px" />
        <span>Im Auen&shy;viertel</span>
      </a>
      <nav aria-label="Hauptnavigation">
        <ul class="nav">
          {nav.map((item) => <li><a href={item.path}>{item.title}</a></li>)}
        </ul>
      </nav>
      <a class="chip chip--sun" href="/contact">Kontakt</a>
    </header>

    <main id="main-content">
      <section class="bento wrap" aria-labelledby="hero-title">
        <div class="tile tile--hero pop" style="--d: 0ms">
          <p class="kicker">Kleingartenverein in Münster-Gievenbeck</p>
          <h1 id="hero-title">
            Hier wächst was
            <span class="squiggle">zusammen!
              <svg viewBox="0 0 300 24" preserveAspectRatio="none" aria-hidden="true"><path d="M3 15c25-10 45 6 72-2s45-10 72-1 48 8 74 0 45-9 76 2" /></svg>
            </span>
          </h1>
          <p class="lede">
            Tomaten, Tratsch und Teamarbeit: Im Auenviertel teilen wir Gartenwissen, Werkzeug und
            jede Menge gute Laune.
          </p>
          <div class="actions">
            <a class="chip chip--ink" href="#termine">Nächste Termine</a>
            <a class="chip" href="/blog">Was gibt’s Neues?</a>
          </div>
        </div>

        <div class="tile tile--veggies pop" style="--d: 90ms">
          <Picture
            src={veggiesImage}
            alt="Illustration: fröhliche Tomate, Aubergine, Karotte, Zwiebel und Blumen"
            widths={[400, 640, 900]}
            sizes="(max-width: 900px) 90vw, 40vw"
            loading="eager"
          />
          <svg class="badge" viewBox="0 0 120 120" aria-hidden="true">
            <defs><path id="badge-circle" d="M60 60m-44 0a44 44 0 1 1 88 0a44 44 0 1 1-88 0" /></defs>
            <circle cx="60" cy="60" r="58" />
            <text><textPath href="#badge-circle">GEMEINSCHAFT · NATUR · ERHOLUNG ·</textPath></text>
          </svg>
        </div>

        <div class="tile tile--hours pop" style="--d: 180ms">
          <p class="kicker">Tor offen</p>
          <p class="big">08–20 Uhr</p>
          <p>vom 15. März bis 30. September</p>
        </div>

        <div class="tile tile--photo pop" style="--d: 240ms">
          <Picture
            src={flowerImage}
            alt="Lila Iris und blaue Krokusse blühen im Frühling"
            widths={[360, 560, 800]}
            sizes="(max-width: 900px) 90vw, 30vw"
          />
          <span class="tag">Frühling im Verein</span>
        </div>

        <a class="tile tile--join pop" style="--d: 300ms" href="/documents">
          <p class="kicker">Lust auf eigene Scholle?</p>
          <p class="big">Mitglied werden →</p>
          <p>Bewerbungsbogen &amp; Checkliste findest du bei den Dokumenten.</p>
        </a>
      </section>

      <div class="marquee" aria-hidden="true">
        <div class="marquee__track">
          {[...marquee, ...marquee].map((word) => <span>{word} <b>✿</b></span>)}
        </div>
      </div>

      <section id="termine" class="wrap section" aria-labelledby="events-title">
        <div class="section__head">
          <h2 id="events-title">Ab in den Kalender!</h2>
          {isSample && <span class="chip chip--small chip--dash">Beispieldaten – neue Saison fehlt noch</span>}
          <a class="chip" href="/dates">Alle Termine</a>
        </div>
        {
          events.length > 0 ? (
            <ul class="pages">
              {events.map((event, i) => (
                <li class:list={["page", `page--${tones[i % tones.length]}`]} style={`--tilt: ${tilts[i % tilts.length]}`}>
                  <div class="page__top">
                    <span class="page__month">{monthShort(event.date)}</span>
                  </div>
                  <div class="page__body">
                    <span class="page__day">{day(event.date)}</span>
                    <span class="page__weekday">{weekday(event.date)}</span>
                    <h3>{event.title}</h3>
                    <p class="page__time">{formatTime(event)}</p>
                    <EventCalendarButton event={event} isSample={isSample} class="page__cal">
                      + Kalender
                    </EventCalendarButton>
                  </div>
                </li>
              ))}
            </ul>
          ) : (
            <p class="empty">Gerade ist Gartenpause – neue Termine folgen bald!</p>
          )
        }
      </section>

      <section class="wrap section toolbox" aria-labelledby="toolbox-title">
        <div class="toolbox__intro tile">
          <h2 id="toolbox-title">Die Werkzeug&shy;kiste</h2>
          <p>Gartenordnung, Formulare und Pläne – alles, was du im Gartenjahr brauchst.</p>
          <Picture
            src={pathImage}
            alt="Der Hauptweg der Anlage mit geschnittenen Hecken"
            widths={[360, 560]}
            sizes="(max-width: 900px) 90vw, 30vw"
          />
        </div>
        <ul class="docs">
          {documents.map((doc, i) => (
            <li>
              <a class:list={["doc", `doc--${tones[i % tones.length]}`]} href={doc.data.file} download>
                <span class="doc__icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8l-5-5Zm0 0v5h5M12 11v6m-3-3 3 3 3-3" /></svg>
                </span>
                <span class="doc__title">{doc.data.title}</span>
                <span class="doc__meta">PDF</span>
              </a>
            </li>
          ))}
        </ul>
        <div class="links tile">
          <h3>Gute Nachbarn im Netz</h3>
          <ul>
            {links.map((link) => (
              <li>
                <a href={link.data.url} target="_blank" rel="noopener noreferrer">
                  {link.data.title} <span aria-hidden="true">↗</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    </main>

    <footer class="wrap footer">
      <p class="footer__word">Im Auenviertel</p>
      <div class="footer__row">
        <a href="mailto:mail@imauenviertel.de">mail@imauenviertel.de</a>
        <ul>
          <li><a href="/impressum">Impressum</a></li>
          <li><a href="/datenschutz">Datenschutz</a></li>
          <li><a href="/contact">Kontakt</a></li>
        </ul>
      </div>
    </footer>
  </div>
</RedesignLayout>

<script>
  import "../../scripts/calendar-button.js";
</script>

<style>
  .beet {
    --cream: #fff6e3;
    --ink: #1f1b16;
    --rust: #d1531f;
    --leaf: #2f8a3c;
    --olive: #a39a2b;
    --river: #1f6fbf;
    --sun: #f7c21b;
    --pink: #f4a6b8;
    --font: "Bricolage Grotesque Variable", ui-sans-serif, system-ui, sans-serif;
    --border: 2.5px solid var(--ink);
    --shadow: 5px 5px 0 var(--ink);

    min-height: 100vh;
    padding-bottom: 6rem;
    color: var(--ink);
    font-family: var(--font);
    font-size: 1.05rem;
    line-height: 1.5;
    background:
      radial-gradient(circle at 1px 1px, rgb(31 27 22 / 0.12) 1px, transparent 0) 0 0 / 22px 22px,
      var(--cream);
  }

  .wrap { width: min(1240px, 100% - 2rem); margin-inline: auto; }
  a { color: inherit; }
  h1, h2, h3 { margin: 0; line-height: 1; font-weight: 800; letter-spacing: -0.02em; font-variation-settings: "wdth" 85; hyphens: auto; overflow-wrap: break-word; }
  p { margin: 0; }

  .chip {
    display: inline-flex;
    align-items: center;
    padding: 0.6rem 1.1rem;
    border: var(--border);
    border-radius: 999px;
    background: #fff;
    font-weight: 700;
    text-decoration: none;
    box-shadow: 3px 3px 0 var(--ink);
    transition: transform 0.15s, box-shadow 0.15s;
  }
  a.chip:hover { transform: translate(-2px, -2px); box-shadow: 5px 5px 0 var(--ink); }
  .chip--sun { background: var(--sun); }
  .chip--ink { background: var(--ink); color: var(--cream); }
  .chip--small { padding: 0.35rem 0.8rem; font-size: 0.85rem; box-shadow: none; }
  .chip--dash { border-style: dashed; background: transparent; }

  /* Header */
  .top { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem; padding-block: 1.25rem; }
  .brand { display: flex; align-items: center; gap: 0.6rem; font-weight: 800; font-size: 1.35rem; text-decoration: none; letter-spacing: -0.02em; }
  .brand :global(img) { width: 40px; height: auto; }
  .nav { display: flex; flex-wrap: wrap; gap: 0.3rem; margin: 0; padding: 0.3rem; list-style: none; border: var(--border); border-radius: 999px; background: #fff; }
  .nav a { display: block; padding: 0.45rem 0.95rem; border-radius: 999px; font-weight: 600; text-decoration: none; }
  .nav a:hover { background: var(--pink); }

  /* Bento */
  .tile { position: relative; overflow: hidden; border: var(--border); border-radius: 28px; box-shadow: var(--shadow); background: #fff; }
  .bento {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    grid-auto-rows: minmax(150px, auto);
    gap: 1.1rem;
    margin-top: 1rem;
  }
  .tile--hero { grid-column: span 7; grid-row: span 3; padding: clamp(1.6rem, 4vw, 3rem); background: var(--sun); display: flex; flex-direction: column; justify-content: flex-end; }
  .tile--veggies { grid-column: span 5; grid-row: span 3; background: #fffdf6; }
  .tile--hours { grid-column: span 3; padding: 1.4rem; background: var(--river); color: #fff; }
  .tile--photo { grid-column: span 4; }
  .tile--join { grid-column: span 5; padding: 1.4rem; background: var(--leaf); color: #fff; text-decoration: none; transition: transform 0.2s, box-shadow 0.2s; }
  .tile--join:hover { transform: translate(-3px, -3px) rotate(-0.5deg); box-shadow: 8px 8px 0 var(--ink); }

  .kicker { font-size: 0.8rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; opacity: 0.85; }
  .tile--hero h1 { margin-top: 1rem; font-size: clamp(2.8rem, 7vw, 6.2rem); }
  .squiggle { position: relative; display: inline-block; color: var(--rust); }
  .squiggle svg { position: absolute; left: 0; bottom: -0.18em; width: 100%; height: 0.3em; fill: none; stroke: var(--ink); stroke-width: 5; stroke-linecap: round; stroke-dasharray: 400; stroke-dashoffset: 400; animation: draw 1.1s 0.5s ease-out forwards; }
  .lede { max-width: 32rem; margin-top: 1.4rem; font-size: 1.2rem; font-weight: 500; }
  .actions { display: flex; flex-wrap: wrap; gap: 0.7rem; margin-top: 1.8rem; }

  .tile--veggies :global(img) { display: block; width: 100%; height: 100%; object-fit: contain; }
  .badge { position: absolute; top: 1rem; right: 1rem; width: 120px; animation: spin 18s linear infinite; }
  .badge circle { fill: var(--pink); stroke: var(--ink); stroke-width: 2.5; }
  .badge text { font: 800 11.5px var(--font); letter-spacing: 0.12em; fill: var(--ink); }

  .big { margin: 0.35rem 0; font-size: clamp(1.7rem, 2.6vw, 2.3rem); font-weight: 800; letter-spacing: -0.02em; line-height: 1.05; }
  .tile--photo :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; }
  .tag { position: absolute; left: 1rem; bottom: 1rem; padding: 0.35rem 0.8rem; border: var(--border); border-radius: 999px; background: #fff; font-weight: 700; font-size: 0.9rem; transform: rotate(-3deg); }

  /* Marquee */
  .marquee { margin-top: 3rem; overflow: hidden; border-block: var(--border); background: var(--rust); color: #fff; transform: rotate(-1.2deg); }
  .marquee__track { display: flex; width: max-content; animation: slide 30s linear infinite; }
  .marquee span { padding: 0.9rem 1.2rem; font-size: 1.6rem; font-weight: 800; letter-spacing: -0.01em; white-space: nowrap; }
  .marquee b { color: var(--sun); }

  /* Sections */
  .section { margin-top: clamp(3.5rem, 7vw, 5.5rem); }
  .section__head { display: flex; flex-wrap: wrap; align-items: center; gap: 0.8rem 1rem; margin-bottom: 2rem; }
  .section__head h2 { margin-right: auto; font-size: clamp(2.2rem, 5vw, 3.8rem); }

  /* Tear-off calendar pages */
  .pages { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.4rem; margin: 0; padding: 0; list-style: none; }
  .page { border: var(--border); border-radius: 22px; overflow: hidden; background: #fff; box-shadow: var(--shadow); transform: rotate(var(--tilt)); transition: transform 0.25s cubic-bezier(0.3, 1.6, 0.5, 1); }
  .page:hover { transform: rotate(0) translateY(-6px); }
  .page__top { position: relative; padding: 0.8rem 1.2rem; border-bottom: var(--border); color: #fff; }
  .page__top::before, .page__top::after { content: ""; position: absolute; top: -8px; width: 12px; height: 22px; border: var(--border); border-radius: 999px; background: var(--cream); }
  .page__top::before { left: 28%; }
  .page__top::after { right: 28%; }
  .page--rust .page__top { background: var(--rust); }
  .page--leaf .page__top { background: var(--leaf); }
  .page--river .page__top { background: var(--river); }
  .page--sun .page__top { background: var(--sun); color: var(--ink); }
  .page__month { font-weight: 800; font-size: 1.1rem; text-transform: uppercase; letter-spacing: 0.1em; }
  .page__body { display: flex; flex-direction: column; align-items: flex-start; padding: 1.1rem 1.2rem 1.3rem; }
  .page__day { font-size: 4.2rem; font-weight: 800; line-height: 0.9; letter-spacing: -0.04em; }
  .page__weekday { font-weight: 600; opacity: 0.6; text-transform: capitalize; }
  .page h3 { margin-top: 0.9rem; font-size: 1.35rem; line-height: 1.1; overflow-wrap: anywhere; hyphens: auto; }
  .page__time { margin-top: 0.3rem; font-weight: 600; }
  .pages :global(.page__cal) { margin-top: 1rem; padding: 0.45rem 0.9rem; border: var(--border); border-radius: 999px; background: var(--cream); font: 700 0.9rem var(--font); color: var(--ink); cursor: pointer; transition: background-color 0.15s; }
  .pages :global(button.page__cal:hover) { background: var(--sun); }
  .pages :global(span.page__cal) { opacity: 0.45; cursor: not-allowed; }
  .empty { font-size: 1.4rem; font-weight: 700; }

  /* Toolbox */
  .toolbox { display: grid; grid-template-columns: 1fr 1.6fr 1fr; gap: 1.1rem; align-items: start; }
  .toolbox__intro { padding: 1.5rem; background: var(--pink); }
  .toolbox__intro h2 { font-size: clamp(2rem, 3.4vw, 2.8rem); }
  .toolbox__intro p { margin-top: 0.8rem; font-weight: 500; }
  .toolbox__intro :global(img) { display: block; width: 100%; height: auto; margin-top: 1.2rem; border: var(--border); border-radius: 18px; }
  .docs { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.9rem; margin: 0; padding: 0; list-style: none; }
  .doc { display: flex; flex-direction: column; gap: 0.6rem; height: 100%; padding: 1.1rem; border: var(--border); border-radius: 20px; background: #fff; text-decoration: none; box-shadow: 3px 3px 0 var(--ink); transition: transform 0.15s, box-shadow 0.15s; }
  .doc:hover { transform: translate(-2px, -2px) rotate(-1deg); box-shadow: 6px 6px 0 var(--ink); }
  .doc__icon { display: grid; place-items: center; width: 44px; height: 44px; border: var(--border); border-radius: 14px; }
  .doc__icon svg { width: 22px; height: 22px; fill: none; stroke: var(--ink); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .doc--rust .doc__icon { background: var(--rust); }
  .doc--leaf .doc__icon { background: var(--leaf); }
  .doc--river .doc__icon { background: var(--river); }
  .doc--sun .doc__icon { background: var(--sun); }
  .doc__title { font-weight: 700; font-size: 1.1rem; line-height: 1.2; }
  .doc__meta { margin-top: auto; font-size: 0.8rem; font-weight: 700; letter-spacing: 0.1em; opacity: 0.55; }
  .links { padding: 1.5rem; background: var(--olive); color: #fff; }
  .links h3 { font-size: 1.6rem; }
  .links ul { margin: 1rem 0 0; padding: 0; list-style: none; }
  .links li + li { border-top: 2px dashed rgb(255 255 255 / 0.45); }
  .links a { display: block; padding: 0.75rem 0; font-weight: 600; text-decoration: none; }
  .links a:hover { text-decoration: underline; text-decoration-thickness: 2px; }

  /* Footer */
  .footer { margin-top: clamp(3.5rem, 7vw, 5.5rem); padding: clamp(1.5rem, 4vw, 2.5rem); border: var(--border); border-radius: 28px; background: var(--ink); color: var(--cream); }
  .footer__word { font-size: clamp(2.6rem, 10vw, 8rem); font-weight: 800; line-height: 0.9; letter-spacing: -0.04em; color: var(--sun); font-variation-settings: "wdth" 75; }
  .footer__row { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1rem; margin-top: 1.5rem; font-weight: 600; }
  .footer__row ul { display: flex; gap: 1.2rem; margin: 0; padding: 0; list-style: none; }

  /* Motion */
  .pop { animation: pop 0.6s cubic-bezier(0.3, 1.5, 0.5, 1) both; animation-delay: var(--d, 0ms); }
  @keyframes pop { from { opacity: 0; transform: scale(0.94) translateY(14px); } }
  @keyframes draw { to { stroke-dashoffset: 0; } }
  @keyframes spin { to { transform: rotate(360deg); } }
  @keyframes slide { to { transform: translateX(-50%); } }

  @media (max-width: 1000px) {
    .tile--hero, .tile--veggies { grid-column: span 12; grid-row: auto; }
    .tile--veggies { max-height: 420px; }
    .tile--hours { grid-column: span 5; }
    .tile--photo { grid-column: span 7; }
    .tile--join { grid-column: span 12; }
    .pages { grid-template-columns: repeat(2, 1fr); }
    .toolbox { grid-template-columns: 1fr; }
  }
  @media (max-width: 600px) {
    .tile--hours, .tile--photo { grid-column: span 12; }
    .tile--photo { height: 240px; }
    .pages, .docs { grid-template-columns: 1fr; }
    .nav { order: 3; width: 100%; justify-content: space-between; }
    .badge { width: 90px; }
  }
</style>
