---
import Layout from "@layouts/Layout.astro";
import Container from "@components/container.astro";
import Sectionhead from "@components/sectionhead.astro";
import { getSortedDocuments, getSortedLinks } from "@utils/content";

const documents = await getSortedDocuments();
const links = await getSortedLinks();
---

<Layout title="Dokumente & Links">
  <Container>
    <Sectionhead eyebrow="Aus dem Vereinsarchiv">
      <Fragment slot="title">Dokumente <em>&amp; Links</em></Fragment>
      <Fragment slot="desc">Ordnungen, Formulare und Pläne zum Herunterladen – und gute Adressen rund ums Kleingärtnern.</Fragment>
    </Sectionhead>

    <div class="lists">
      <section aria-labelledby="documents-title">
        <h2 id="documents-title" class="list-title">Dokumente</h2>
        <ul class="rows">
          {
            documents.map((doc, i) => (
              <li data-reveal style={`--reveal-delay: ${Math.min(i, 6) * 60}ms`}>
                <a href={doc.data.file} download>
                  <span class="rows__num">{String(i + 1).padStart(2, "0")}</span>
                  <span class="rows__text">
                    <span class="rows__title">{doc.data.title}</span>
                    {doc.data.description && <span class="rows__desc">{doc.data.description}</span>}
                  </span>
                  <span class="rows__meta">PDF ↓</span>
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="links" aria-labelledby="links-title" data-reveal style="--reveal-delay: 150ms">
        <h2 id="links-title" class="list-title">Interessante Links</h2>
        <ul>
          {
            links.map((link) => (
              <li>
                <a href={link.data.url} target="_blank" rel="noopener noreferrer">
                  <span class="links__title">{link.data.title} <span aria-hidden="true">↗</span></span>
                  {link.data.description && <span class="links__desc">{link.data.description}</span>}
                </a>
              </li>
            ))
          }
        </ul>
      </section>
    </div>
  </Container>
</Layout>

<style>
  .lists { display: grid; grid-template-columns: 1.6fr 1fr; gap: clamp(2rem, 5vw, 5rem); align-items: start; }
  .list-title { margin: 0 0 0.8rem; font-size: 2rem; }

  .rows { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--color-line); }
  .rows a { position: relative; display: grid; grid-template-columns: 3.2rem minmax(0, 1fr) auto; align-items: baseline; gap: 1rem; padding: 1.4rem 0.4rem; border-bottom: 1px solid var(--color-line); text-decoration: none; isolation: isolate; }
  .rows a::before { content: ""; position: absolute; inset: 0; z-index: -1; background: var(--color-surface); transform: scaleY(0); transform-origin: bottom; transition: transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1); }
  .rows a:hover::before { transform: scaleY(1); }
  .rows__num { font-size: 0.85rem; font-weight: 700; color: var(--color-muted); }
  .rows__text { display: flex; flex-direction: column; gap: 0.3rem; transition: transform 0.3s; }
  .rows a:hover .rows__text { transform: translateX(8px); }
  .rows__title { font-family: var(--font-display); font-size: clamp(1.5rem, 2.6vw, 2.1rem); line-height: 1.1; }
  .rows a:hover .rows__title { color: var(--color-accent); }
  .rows__desc { font-size: 0.92rem; color: rgb(31 58 43 / 0.7); }
  .rows__meta { font-size: 0.8rem; font-weight: 700; letter-spacing: 0.1em; color: var(--color-muted); white-space: nowrap; }

  .links { padding: 1.6rem 1.8rem; border: 1px solid var(--color-line); border-radius: var(--radius-leaf); background: linear-gradient(135deg, #fff, var(--color-surface)); }
  .links ul { margin: 0; padding: 0; list-style: none; }
  .links li + li { border-top: 1px solid var(--color-line); }
  .links a { display: flex; flex-direction: column; gap: 0.25rem; padding: 0.9rem 0; text-decoration: none; }
  .links__title { font-weight: 600; line-height: 1.35; }
  .links a:hover .links__title { color: var(--color-accent); }
  .links__desc { font-size: 0.88rem; color: rgb(31 58 43 / 0.7); }

  @media (max-width: 900px) {
    .lists { grid-template-columns: 1fr; }
  }
  @media (max-width: 600px) {
    .rows a { grid-template-columns: 2.4rem minmax(0, 1fr); }
    .rows__meta { display: none; }
  }
</style>
