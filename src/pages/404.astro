---
import Container from "@components/container.astro";
import Layout from "@layouts/Layout.astro";
import { Picture } from "astro:assets";

import PAGE_NOT_FOUND from "../assets/404.png";
---

<Layout title="Seite nicht gefunden">
  <Container>
    <div class="missing">
      <div class="missing__text">
        <p class="eyebrow">Fehler 404</p>
        <h1>Hier wächst <em>leider nichts.</em></h1>
        <p class="missing__desc">
          Diese Seite wurde leider nicht gefunden. Vielleicht wurde sie verschoben – auf der
          Startseite findest du alles Wichtige.
        </p>
        <div class="missing__actions">
          <a class="btn" href="/">
            Zur Startseite
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"></path></svg>
          </a>
          <a class="link-arrow" href="/blog">Neuigkeiten <span aria-hidden="true">→</span></a>
        </div>
      </div>
      <figure class="missing__image">
        <Picture
          src={PAGE_NOT_FOUND}
          alt="Illustration: eine ratlose Karotte vor der Zahl 404"
          widths={[400, 640, 800]}
          sizes="(max-width: 800px) 90vw, 40vw"
          loading="eager"
        />
      </figure>
    </div>
  </Container>
</Layout>

<style>
  .missing { display: grid; grid-template-columns: 1.1fr 1fr; align-items: center; gap: clamp(2rem, 5vw, 5rem); min-height: min(calc(100vh - 16rem), 44rem); padding-block: clamp(3rem, 6vw, 5rem); }
  .missing h1 { margin: 1rem 0 0; font-size: clamp(3rem, 7vw, 5.6rem); line-height: 0.95; }
  .missing__desc { max-width: 32rem; margin: 1.4rem 0 0; font-size: 1.15rem; color: rgb(31 58 43 / 0.8); }
  .missing__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.6rem; margin-top: 2rem; }
  .missing__image { margin: 0; overflow: hidden; border-radius: var(--radius-leaf); }
  .missing__image :global(img) { display: block; width: 100%; height: auto; }
  @media (max-width: 800px) {
    .missing { grid-template-columns: 1fr; min-height: 0; }
  }
</style>
