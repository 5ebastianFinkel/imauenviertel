---
import { Picture } from "astro:assets";
import Logo from "@assets/logo.avif";

interface Props {
  // Transparent header laid over the start page hero
  overlay?: boolean;
}

const { overlay = false } = Astro.props;

const menuitems = [
  { title: "Neuigkeiten", path: "/blog" },
  { title: "Termine", path: "/dates" },
  { title: "Über uns", path: "/about" },
  { title: "Dokumente & Links", path: "/documents" },
  { title: "Kontakt", path: "/contact" },
];

const isCurrent = (path: string) => Astro.url.pathname.startsWith(path);
---

<header class:list={["site-header", overlay && "site-header--overlay"]}>
  <div class="site-header__inner">
    <a href="/" class="brand" aria-label="Im Auenviertel – zur Startseite">
      <span class="brand__mark">
        <Picture src={Logo} alt="" widths={[48, 96]} sizes="30px" loading="eager" />
      </span>
      <span class="brand__name">Im Auenviertel</span>
    </a>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-menu">
      <span class="menu-toggle__label">Menü</span>
      <span class="menu-toggle__icon" aria-hidden="true"><span></span></span>
    </button>

    <nav id="site-menu" class="site-nav" aria-label="Hauptnavigation">
      <ul>
        {
          menuitems.map((item) => (
            <li>
              <a href={item.path} aria-current={isCurrent(item.path) ? "page" : undefined}>
                {item.title}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>(".site-header");
  const toggle = header?.querySelector<HTMLButtonElement>(".menu-toggle");

  const setOpen = (open: boolean) => {
    header?.toggleAttribute("data-open", open);
    toggle?.setAttribute("aria-expanded", String(open));
  };

  toggle?.addEventListener("click", () => setOpen(!header?.hasAttribute("data-open")));
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && header?.hasAttribute("data-open")) {
      setOpen(false);
      toggle?.focus();
    }
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--color-line);
    background: rgb(251 247 238 / 0.88);
    backdrop-filter: blur(12px);
  }
  .site-header--overlay {
    position: absolute;
    inset: 0 0 auto;
    border-bottom: 0;
    background: transparent;
    backdrop-filter: none;
  }
  .site-header__inner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    width: min(1240px, 100% - 2.5rem);
    margin-inline: auto;
    padding-block: 1rem;
  }
  .site-header--overlay .site-header__inner { padding-block: 1.5rem; }

  .brand { display: flex; align-items: center; gap: 0.75rem; font-family: var(--font-display); font-size: 1.6rem; line-height: 1; text-decoration: none; }
  .brand__mark { display: grid; place-items: center; overflow: hidden; width: 46px; height: 46px; border-radius: 50%; background: #fff; box-shadow: 0 4px 14px -6px rgb(31 58 43 / 0.35); }
  .brand__mark :global(picture) { display: block; }
  .brand__mark :global(img) { display: block; width: auto; height: 30px; }

  .site-nav ul { display: flex; flex-wrap: wrap; gap: 0.25rem 1.8rem; margin: 0; padding: 0; list-style: none; font-size: 0.95rem; font-weight: 500; }
  .site-nav a { position: relative; padding-block: 0.3rem; text-decoration: none; transition: color 0.2s; }
  .site-nav a::after { content: ""; position: absolute; left: 0; right: 0; bottom: -2px; height: 2px; border-radius: 2px; background: var(--color-sun); transform: scaleX(0); transform-origin: left; transition: transform 0.3s cubic-bezier(0.2, 0.7, 0.2, 1); }
  .site-nav a:hover { color: var(--color-accent); }
  .site-nav a:hover::after, .site-nav a[aria-current="page"]::after { transform: scaleX(1); }

  .menu-toggle { display: none; }

  @media (max-width: 900px) {
    .menu-toggle {
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      padding: 0.55rem 0.9rem;
      border: 1px solid var(--color-line);
      border-radius: var(--radius-leaf-sm);
      background: #fff;
      color: var(--color-ink);
      font: 600 0.9rem var(--font-sans);
      cursor: pointer;
    }
    .menu-toggle__icon { position: relative; width: 18px; height: 12px; }
    .menu-toggle__icon::before, .menu-toggle__icon::after, .menu-toggle__icon span {
      content: ""; position: absolute; left: 0; width: 100%; height: 2px; border-radius: 2px; background: currentColor; transition: transform 0.25s, opacity 0.2s;
    }
    .menu-toggle__icon::before { top: 0; }
    .menu-toggle__icon span { top: 5px; }
    .menu-toggle__icon::after { top: 10px; }
    .site-header[data-open] .menu-toggle__icon::before { transform: translateY(5px) rotate(45deg); }
    .site-header[data-open] .menu-toggle__icon span { opacity: 0; }
    .site-header[data-open] .menu-toggle__icon::after { transform: translateY(-5px) rotate(-45deg); }

    /* Without JS the links simply wrap below the brand */
    :global(html:not(.js)) .menu-toggle { display: none; }
    :global(html:not(.js)) .site-header__inner { flex-wrap: wrap; }

    :global(html.js) .site-nav {
      position: absolute;
      top: calc(100% + 0.5rem);
      left: 0;
      right: 0;
      padding: 1rem 1.25rem;
      border: 1px solid var(--color-line);
      border-radius: var(--radius-leaf);
      background: var(--color-paper);
      box-shadow: 0 24px 50px -24px rgb(31 58 43 / 0.45);
      opacity: 0;
      visibility: hidden;
      transform: translateY(-8px);
      transition: opacity 0.2s, transform 0.2s, visibility 0s 0.2s;
    }
    :global(html.js) .site-header[data-open] .site-nav {
      opacity: 1;
      visibility: visible;
      transform: none;
      transition: opacity 0.2s, transform 0.2s;
    }
    :global(html.js) .site-nav ul { flex-direction: column; gap: 0; }
    :global(html.js) .site-nav li + li { border-top: 1px solid var(--color-line); }
    :global(html.js) .site-nav a { display: block; padding: 0.8rem 0.25rem; font-family: var(--font-display); font-size: 1.6rem; font-weight: 400; }
    :global(html.js) .site-nav a::after { display: none; }
    :global(html.js) .site-nav a[aria-current="page"] { color: var(--color-accent); }
  }
</style>
