{
  "name": "astroship",
  "type": "module",
  "version": "2.2.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:ci": "oxlint --max-warnings 0",
    "typecheck": "astro sync && tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "typecheck:ci": "astro sync && tsc --noEmit --strict"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "js-yaml": "^4.3.2",
    "jsdom": "29.1.1",
    "oxlint": "1.87.0",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@astrojs/mdx": "^5.0.6",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^6.4.8",
    "astro-seo": "^1.2.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.3.3"
  }
}